{
  "name": "toolbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/assets.mjs ensure --strict",
    "dev": "vite",
    "prebuild": "node scripts/assets.mjs ensure",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node scripts/serve.mjs",
    "start:site": "node scripts/serve-site.mjs",
    "setup": "node scripts/assets.mjs sync",
    "setup:lite": "node scripts/assets.mjs sync --lite",
    "assets": "node scripts/assets.mjs",
    "verify": "node scripts/assets.mjs verify",
    "containers": "python3 scripts/extract-containers.py",
    "fonts": "python3 scripts/extract-containers.py && python3 scripts/extract-font-zh.py",
    "typecheck": "tsc -b",
    "pages:build": "VITE_BASE=/$(basename $PWD)/ pnpm build && node scripts/assets.mjs pack --out=dist-site"
  },
  "dependencies": {
    "ag-psd": "^34.1.0",
    "gifenc": "^1.0.3",
    "mp4-muxer": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "yauzl": "^3.4.0"
  },
  "packageManager": "pnpm@10.28.2"
}
